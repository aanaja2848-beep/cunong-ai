# ========== FastAPI Settings ==========
FASTAPI_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-secret-key-change-this-in-production

# ========== Database ==========
# SQLite (Development)
DATABASE_URL=sqlite:///./trading.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/cunong

# ========== MetaTrader 5 ==========
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_LOGIN=your-demo-account-number
MT5_PASSWORD=your-mt5-password
MT5_SERVER=demo.metatrader5.com

# ========== AI & API Keys ==========
GEMINI_API_KEY=your-google-gemini-api-key
NEWS_API_KEY=your-newsapi-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ========== Telegram Security ==========
TELEGRAM_ALLOWED_USERS=123456789,987654321,111111111

# ========== Trading Settings ==========
MAX_RISK_PERCENT=2
DAILY_LOSS_LIMIT=500.0
DAILY_PROFIT_TARGET=1000.0
MIN_CONFIDENCE_THRESHOLD=65

# ========== Ramadan Mode ==========
RAMADAN_MODE_ENABLED=true
PRAYER_TIMES_CITY=Jakarta
PRAYER_TIMES_COUNTRY=Indonesia

# ========== Ollama Local LLM ==========
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ========== Logging ==========
LOG_LEVEL=INFO
LOG_DIR=logs/

# ========== Sentry Monitoring (Optional) ==========
SENTRY_DSN=

# ========== Frontend ==========
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000